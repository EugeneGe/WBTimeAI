{
  "name": "@wbtime/config",
  "version": "0.3.0",
  "private": true,
  "description": "WBTimeAI 平台基座 · 环境变量 + 默认值加载（local = SQLite 档 / server = PG 档）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "tsc -b tsconfig.json && node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@wbtime/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
