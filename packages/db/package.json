{
  "name": "@wbtime/db",
  "version": "0.3.1",
  "private": true,
  "description": "WBTimeAI 数据层 · Drizzle 双档 schema（PG / SQLite）+ ScopedRepo 泛型仓储 —— 结构由 contracts/schema.v0018.*.normalized.json 生成，禁手改",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./repositories": {
      "types": "./dist/repositories/index.d.ts",
      "default": "./dist/repositories/index.js"
    },
    "./connection": {
      "types": "./dist/connection.d.ts",
      "default": "./dist/connection.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "introspect": "tsc -b tsconfig.json && node dist/schema/_introspect.js --out ../../output",
    "test": "tsc -b tsconfig.json && node --experimental-sqlite --test \"tests/**/*.test.mjs\"",
    "test:typecheck": "node tests/typecheck/run.mjs"
  },
  "dependencies": {
    "@wbtime/domain": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.7.0"
  }
}
