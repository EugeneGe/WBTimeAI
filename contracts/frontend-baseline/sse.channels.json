{
  "source": "数据源 = contracts/sse/channels.json",
  "normalized_by": "scripts/gen_frontend_baseline.py",
  "contract_version": 1,
  "frame_format": {
    "content_type": "text/event-stream",
    "data_frame": {
      "bytes_note": "帧以空行结尾（两个 \\n），逐字节可比，不得追加换行。",
      "line_layout": [
        "id: <int>",
        "event: <channel>",
        "data: <json>",
        "",
        ""
      ],
      "seq_policy": "19 条 golden 统一 id: 1（SEQ=1）。真实流中 id 等于 agent_event.seq，由 EventDispatcher 投递前分配；golden 固定 1 是为了让 diff 只反映通道差异。",
      "template": "id: {seq}\\nevent: {channel}\\ndata: {json}\\n\\n"
    },
    "heartbeat": {
      "carries_id": false,
      "default_interval_seconds": 15.0,
      "note": "注释帧不带 id:，不污染 Last-Event-ID（§2.2）。",
      "only_when_idle": true,
      "sample": ": hb 1700000000000\n\n",
      "sample_now_ms": 1700000000000,
      "sha256": "714b4652a5b5698a9f4939a3739b1c89ae5e8c449d0e2a7d0d199634b5a70e16",
      "template": ": hb {now_ms}\\n\\n"
    },
    "json": {
      "ensure_ascii": false,
      "indent": null,
      "note": "ensure_ascii=False：CJK 原样输出，**不得**出现 \\uXXXX 转义；separators=(',',':')：紧凑无空格；sort_keys=False：键序 = payload 插入序，TS 侧必须保序（Object.keys 顺序即契约）。",
      "separators": [
        ",",
        ":"
      ],
      "sort_keys": false
    },
    "line_endings": "LF only — 帧内不得出现 CR",
    "wrapped_by_response_shell": false,
    "wrapped_note": "§11.1 例外：SSE 帧不套 {code,message,data,request_id} 壳；request_id 仅经响应头下发。"
  },
  "counts": {
    "channels": 19
  },
  "channels": [
