# Astra AI 环境变量示例（统一前缀 ASTRA_）
#
# 使用方式：复制为 .env 并按需修改。注意：.env 已被 .gitignore 忽略，禁止提交真实密钥。
# 本文件仅为占位示例，不含任何真实密钥。

# 运行模式：local（SQLite + 进程内） | server（PostgreSQL + 外部中间件）
# 仅 packages/config/src/astra_config/providers.py 的 build_providers() 依据此值分流。
ASTRA_MODE=local

# 数据库连接串（local 默认 SQLite；server 使用 PostgreSQL）
ASTRA_DATABASE_URL=sqlite:///./astra_local.db

# 应用主密钥（AES-GCM 派生 / JWT 签名用；从环境变量读取，禁止写入 config.yaml）
# 🔴 要求：**≥32 字节**（HS256 密钥空间 ≥256 bit，对齐 AES-256）。
#    短于 32 字节时启动/校验即拒绝（DomainError: CONFIGURATION_ERROR，P0-05）。
#    生成示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
#    下方仅为占位示例（非真实密钥），请替换为强随机值。
ASTRA_SECRET_KEY=change-me-to-a-random-secret-at-least-32-bytes

# 本地数据目录（local 模式：存储根；派生 storage/ secrets/ 等子目录）
ASTRA_DATA_DIR=~/.astra-ai

# 服务器工作区根目录（T2-55；server 档 Project / Attempt 的宿主根）
# 🔴 Project / Attempt 路径由服务端 UUID 派生（projects/<id>/repo、executions/<id>/...）；
#    API 只暴露不透明 checkout_ref，**不接受**客户端 path、**不返回**宿主绝对路径。
# Linux 部署默认 /var/lib/astra-ai/workspaces（由 Astra 服务账号拥有）；允许管理员覆写。
# 容器部署须将该目录挂载到持久卷（见 docker-compose.yml 的 workspace-data 卷）。
ASTRA_WORKSPACE_ROOT=/var/lib/astra-ai/workspaces

# 认证与令牌（决策 D1 / D8）
ASTRA_JWT_ALGORITHM=HS256
ASTRA_ACCESS_TOKEN_TTL_SECONDS=900
ASTRA_REFRESH_TOKEN_TTL_SECONDS=1209600
ASTRA_LOGIN_MAX_ATTEMPTS=5
ASTRA_LOGIN_LOCK_SECONDS=900
# 机密提供者类型（Phase 0 仅支持 env；未来可接 Vault / KMS）
ASTRA_SECRET_PROVIDER=env

# 日志
ASTRA_LOG_LEVEL=INFO
ASTRA_LOG_FORMAT=console

# HTTP 服务
ASTRA_HOST=127.0.0.1
ASTRA_PORT=8080

# 跨域来源（JSON 数组格式）
ASTRA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---------------------------------------------------------------------------
# Phase 1 能力配置（可选；装配在 packages/config/.../providers.py 的 build_providers）
# ---------------------------------------------------------------------------
# Model Provider 默认（可选；留空 = 未配置，Model Router 显式路由时校验）。
# ASTRA_MODEL_DEFAULT_PROVIDER=openai
# ASTRA_MODEL_DEFAULT_MODEL=gpt-4o-mini

# Sandbox（设计 §5 #3 拍板）：local_process（社区默认，进程级隔离） | docker
ASTRA_SANDBOX_PROVIDER=local_process
# Docker 沙箱镜像基线（§5 #3 定版）
ASTRA_SANDBOX_IMAGE=python:3.12-slim
# 可选：沙箱工作目录挂载点（留空 = 由 SandboxProvider 解析为 Workspace 目录）
# ASTRA_SANDBOX_WORKDIR=

# Sandbox 网络隔离（T2-56；设计 §2.18）：Agent / Build / Test Sandbox 默认无网络。
#   offline（默认）：network=none；
#   allowlisted：接入内部网络（internal: true，无外部路由）+ 受控 Egress Proxy（复用 EgressPolicy）。
ASTRA_SANDBOX_NETWORK_PROFILE=offline
# ALLOWLISTED 档接入的内部网络名（compose 创建；默认 astra-sandbox-egress）。
ASTRA_SANDBOX_EGRESS_NETWORK=astra-sandbox-egress
# 受控 Egress Proxy 地址（ALLOWLISTED 档注入沙箱容器 HTTP(S)_PROXY；留空 = 不注入）。
# 部署方须显式配置 ASTRA_EGRESS__ALLOW（默认空 = 拒绝全部出网）。
# ASTRA_SANDBOX_EGRESS_PROXY_URL=http://egress-proxy:8888
# Egress 白名单（JSON 数组；默认空 = 拒绝全部出网；deny_private 不可被覆盖）。
# ASTRA_EGRESS__ALLOW=["pypi.org","files.pythonhosted.org","github.com"]

# Run 级总超时（毫秒）：重启兜底扫描阈值（RUNNING Run 心跳超期 → FAILED/HEARTBEAT_TIMEOUT）
ASTRA_RUN_TIMEOUT_MS=900000

# SSE 心跳注释帧间隔（秒；仅在空闲时发送，不污染 Last-Event-ID）
ASTRA_SSE_HEARTBEAT_SECONDS=15


# 可观测（设计 §2.7.3）：/metrics 开关（社区默认 false，Team 可开）。
# ENV 采用嵌套分隔符 `__`：
# ASTRA_OBSERVABILITY__METRICS_ENABLED=true

# Feature Flag（T0-21 / 决策 D7）：配置覆盖，JSON 对象（name → bool）。
# 合并优先级（高 → 低）：配置覆盖（本项）→ 数据库覆盖（feature_flag 表）→ 默认(全开)。
# 空 {} = 全部按注册表默认（全开）。示例：临时关闭 registration：
#   ASTRA_FEATURE_FLAGS={"registration": false}
ASTRA_FEATURE_FLAGS={}

# 可选：外部 config.yaml 路径（ENV → config.yaml → 默认值 三级加载）
# ASTRA_CONFIG_FILE=./config.yaml

# ---------------------------------------------------------------------------
# 部署（T0-22 / T2-54）：标准模式（docker compose，ASTRA_MODE=server）
# ---------------------------------------------------------------------------
# 说明：`docker compose up` 已在 compose 文件中注入下列变量；此处仅作参考。
#   标准/开发模式：api + web + worker + postgres + redis（ASTRA_MODE=server）
#   社区单容器：  docker compose -f deployments/compose/docker-compose.community.yml up
#                （ASTRA_MODE=local：SQLite + 本地文件 + 进程内任务，零外部中间件）
#
# server 模式示例（两档均开源；不以商业 Feature Flag 区分）：
# ASTRA_MODE=server
# ASTRA_DATABASE_URL=postgresql+psycopg://astra:astra@postgres:5432/astra
# ASTRA_SECRET_KEY=replace-with-strong-random-secret
# ASTRA_HOST=0.0.0.0
# ASTRA_PORT=8080
# ASTRA_FEATURE_FLAGS={}
# ASTRA_WORKSPACE_ROOT=/var/lib/astra-ai/workspaces
#
# server 档 Provider 闭环（T2-54，均由 packages/config/.../providers.py 唯一装配）：
#   - Community 基础档（未设 ASTRA_REDIS_URL）：DB + LocalFileStorage + LocalEventBus
#     + InProcessTaskQueue + InProcessBackgroundExecutor + LocalScheduler + LocalProcessSandbox；
#   - Compose / Team 档（设 ASTRA_REDIS_URL 且安装 astra-task[redis]）：DB + RedisTaskQueue
#     + Worker 进程执行体 + DockerSandbox（见 docker-compose.yml）。
#   缺少可选依赖（如显式设了 ASTRA_REDIS_URL 但缺 astra-task[redis]）→ 启动即报明确
#   CONFIGURATION_ERROR，**不**装配占位后延迟到首次请求才失败；`astra doctor` 报告能力闭环。
#
# 外部中间件（Compose 档）：
#   postgres:5432   redis:6379
#
# Compose 档镜像与 socket 授权（T2-54 · F-1/F-3）：
#   - postgres 镜像 = pgvector/pgvector:pg16（**必须**；普通 postgres:16* 无 vector 扩展 →
#     迁移 0013/0014 将 embedding/memory.vector 降级为 JSONB，而 ORM VectorType 降级为 JSON
#     → alembic check 报假漂移；pgvector 镜像下零漂移。与 CI 权威面 test.yml 一致）。
#   - worker 以**非 root** 运行，需**追加**宿主 docker 组 GID 才能访问 docker.sock
#     （root:docker 660），否则 docker_available()=False、worker 无法启动。
#     取值：stat -c '%g' /var/run/docker.sock （默认 1001）。
ASTRA_DOCKER_GID=1001

# ---------------------------------------------------------------------------
# CLI（决策 D5）：`astra init` 会生成 `~/.astra-ai/` 目录树
#   ~/.astra-ai/{data,workspace,storage,logs,secrets}/  +  ~/.astra-ai/config.yaml
# 说明：
#   - 生成的 config.yaml 仅含**非敏感项**（mode/host/port/日志/data_dir）；
#     敏感键（secret_key / 含密码的 database_url）**不写入**，仅经 ENV 或 secrets/ 提供；
#   - `astra doctor` 自检 5 项；`astra run` 复用 `astra_api.main:app`（默认 127.0.0.1:8080）。
# 命令：`astra init`  →  `astra run`  →  `astra doctor`
# ---------------------------------------------------------------------------
